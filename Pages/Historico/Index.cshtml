@page
@model MS.Pages.Historico.IndexModel
@*
    ============================================================================
    TELA: HISTÓRICO (visual)  ·  lógica em Index.cshtml.cs — tabela com data, usuário, ação e detalhes.
    ============================================================================
*@
@{
    ViewData["Title"] = "Histórico";
    ViewData["Trilha"] = Model.Titulo;
}
<p class="text-muted">Quem mudou o quê e quando.</p>
<div class="cartao">
    <table class="tabela tabela-cards">
        <thead><tr><th>Data</th><th class="esq">Usuário</th><th class="esq">Ação</th><th class="esq">Detalhes</th></tr></thead>
        <tbody>
            @foreach (var h in Model.Lista)
            {
                <tr>
                    <td data-rotulo="Data">@h.Quando.Data()</td>
                    <td class="esq" data-rotulo="Usuário">@h.Usuario</td>
                    <td class="esq" data-rotulo="Ação"><b>@h.Acao</b></td>
                    <td class="esq" data-rotulo="Detalhes" style="white-space:pre-wrap">@Model.Detalhes(h)</td>
                </tr>
            }
            @if (!Model.Lista.Any()) { <tr><td colspan="4" class="text-muted text-center">Nenhuma alteração registrada.</td></tr> }
        </tbody>
    </table>
</div>
<p class="mt-3"><a href="javascript:history.back()">&larr; Voltar</a></p>
