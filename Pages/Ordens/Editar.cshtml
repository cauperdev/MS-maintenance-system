@page "{id:int?}"
@model MS.Pages.Ordens.EditarModel
@*
    ============================================================================
    TELA: ORDENS DE SERVIÇO — executar/editar (visual)  ·  lógica em Editar.cshtml.cs
    Abas: 1. Geral (número, equipamento, periodicidade, status, técnico, coordenador, datas)
          2. Tarefas (checklist) · 3. Peças utilizadas · 4. Imagens (antes / depois)
          (o motivo de uma conclusão retornada aparece na lista de Ordens de serviço, coluna Retorno)
    Botões no fim: Salvar · Concluir · Salvar e adicionar outro · Salvar e continuar editando · Remover
                   · Salvar e abrir NRE (com as NRE já abertas desta OS embaixo).
    ============================================================================
*@
@{
    ViewData["Title"] = "Ordens de serviço";
    ViewData["Trilha"] = "Manutenção";
    ViewData["TrilhaPagina"] = "Ordens de serviço";
    ViewData["TrilhaUrl"] = Url.Page("Index");
    ViewData["TrilhaAtual"] = Model.Novo ? "Adicionar" : $"OS {Model.Os.Numero} - {Model.Os.Equipamento?.Codigo}";
    var os = Model.Os;
    var travadoPlano = os.PlanoId != null;
    var atrasada = !Model.Novo && os.Atrasada(DateTime.Now);
}
<form method="post" class="form-layout" enctype="multipart/form-data" id="formOs">
    <input type="hidden" id="abaAtiva" name="abaAtiva" value="@Model.AbaAtiva" />
    <div class="cartao">
        <ul class="nav abas" role="tablist">
            <li class="nav-item"><button type="button" class="nav-link active" data-bs-toggle="tab" data-bs-target="#aba-geral">General</button></li>
            <li class="nav-item"><button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#aba-tarefas" id="linkTarefas">Tarefas</button></li>
            <li class="nav-item"><button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#aba-pecas">Peças utilizadas</button></li>
            <li class="nav-item"><button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#aba-imagens">Imagens</button></li>
        </ul>
        <div asp-validation-summary="All" class="text-danger mt-3"></div>
        <div class="tab-content">
            <div class="tab-pane fade show active painel-form" id="aba-geral">
                <div class="campo"><label>Número da OS</label><input class="form-control" readonly value="@(Model.Novo ? "(gerado ao salvar)" : os.Numero)" /></div>
                <div class="campo">
                    <label class="obrig" for="Os_EquipamentoId">Equipamento</label>
                    @if (Model.Novo)
                    {
                        <select class="form-select" asp-for="Os.EquipamentoId" required data-pesquisa>
                            <option value="">Selecione…</option>
                            @foreach (var e in Model.Equipamentos) { <option value="@e.Id">@e.Descricao · @e.Localizacao</option> }
                        </select>
                    }
                    else
                    {
                        <input class="form-control" readonly value="@os.Equipamento?.Descricao" />
                    }
                </div>
                @if (!Model.Novo)
                {
                    <div class="campo"><label>Prédio</label><input class="form-control" readonly value="@(os.Equipamento?.Predio is { Length: > 0 } predio ? predio : "-")" /></div>
                    <div class="campo"><label>Localização</label><input class="form-control" readonly value="@os.Equipamento?.Localizacao" /></div>
                    <div class="campo"><label>Plano</label><input class="form-control" readonly value="@(os.Plano != null ? $"{os.Plano.Nome} · {os.Plano.Periodicidade.Nome()}" : "OS avulsa (sem plano)")" /></div>
                }
                <div class="campo">
                    <label class="obrig" for="Os_Tipo">Tipo (periodicidade)</label>
                    <div>
                        @if (travadoPlano)
                        {
                            <input type="hidden" asp-for="Os.Tipo" />
                            <input class="form-control" readonly value="@os.Tipo.Nome() — definido pelo Cronograma" />
                        }
                        else
                        {
                            <select class="form-select" asp-for="Os.Tipo">
                                @foreach (var p in Enum.GetValues<Periodicidade>()) { <option value="@p">@p.Nome()</option> }
                            </select>
                        }
                        @if (Model.Novo) { <div class="ajuda">Se o equipamento tiver um plano com este tipo, a OS nasce com as tarefas do plano.</div> }
                    </div>
                </div>
                <div class="campo">
                    <label>Status</label>
                    <div>
                        @* Definido pelo sistema e travado: só mostra Aberta ou Atrasada. *@
                        <input class="form-control @(atrasada ? "st-atrasada" : "st-aberta")" readonly style="max-width:260px"
                               value="@(atrasada ? "Atrasada" : "Aberta")" />
                        <div class="ajuda">Definido pelo sistema: Atrasada quando passa da data da manutenção; senão, Aberta. Ao clicar em Salvar com pelo menos uma tarefa marcada, o ciclo vai para a Finalização e a OS continua com a próxima data. "Salvar e continuar editando" só guarda o andamento.</div>
                    </div>
                </div>
                <div class="campo">
                    <label for="Os_TecnicoId">Técnico responsável</label>
                    <select class="form-select" asp-for="Os.TecnicoId" asp-items="@(new SelectList(Model.Tecnicos, "Id", "NomeCompleto"))"><option value="">—</option></select>
                </div>
                <div class="campo">
                    <label for="Os_CoordenadorId">Coordenador responsável</label>
                    <select class="form-select" asp-for="Os.CoordenadorId" asp-items="@(new SelectList(Model.Coordenadores, "Id", "NomeCompleto"))"><option value="">—</option></select>
                </div>
                <div class="campo"><label for="Os_Descricao">Descrição do problema/serviço</label><textarea class="form-control" asp-for="Os.Descricao" rows="4"></textarea></div>
                @if (travadoPlano)
                {
                    @* OS do plano: a data é definida no Cronograma *@
                    <div class="campo">
                        <label>Data da manutenção</label>
                        <div>
                            <input class="form-control @(atrasada ? "is-invalid" : "")" readonly value="@os.DataConclusao.ToString("dd/MM/yyyy")" style="max-width:220px" />
                            <div class="ajuda"><a asp-page="/Cronograma/Editar" asp-route-id="@os.PlanoId">Alterar no Cronograma</a></div>
                        </div>
                    </div>
                    <div class="campo"><label>Próxima manutenção</label><input class="form-control" readonly value="@Regras.ProximaManutencao(os).ToString("dd/MM/yyyy")" style="max-width:220px" /></div>
                }
                else
                {
                    @* OS avulsa (ou nova): a data é escolhida aqui *@
                    <div class="campo">
                        <label class="obrig" for="dataManutencao">Data da manutenção</label>
                        <input class="form-control @(atrasada ? "is-invalid" : "")" type="date" name="DataManutencao" id="dataManutencao" style="max-width:220px" required
                               value="@(Model.Novo ? Regras.SemDomingo(DateTime.Today).ToString("yyyy-MM-dd") : os.DataConclusao.ToString("yyyy-MM-dd"))" data-proxima="#proximaManutencao" data-periodo="#Os_Tipo" />
                    </div>
                    <div class="campo">
                        <label for="proximaManutencao">Próxima manutenção</label>
                        <div>
                            <input class="form-control" type="date" name="ProximaManutencao" id="proximaManutencao" style="max-width:220px"
                                   value="@(Model.Novo ? "" : Regras.ProximaManutencao(os).ToString("yyyy-MM-dd"))" />
                            <div class="ajuda">Calculada automaticamente pela periodicidade — pode ser alterada.</div>
                        </div>
                    </div>
                }
            </div>

            <div class="tab-pane fade painel-form p-2 p-md-3" id="aba-tarefas">
                @if (Model.Novo)
                {
                    <p class="text-muted small">A OS nasce com as tarefas do plano do equipamento (mesmo tipo). Se não houver plano, escreva as tarefas abaixo, uma por linha — depois de salvar, o texto fica travado.</p>
                    <textarea class="form-control" asp-for="TarefasNovas" rows="6" placeholder="LIMPEZA DA ESTRUTURA&#10;VERIFICAÇÃO DE BELT"></textarea>
                }
                else
                {
                    <div class="checklist-linha fw-bold border-bottom"><span>Tarefa</span><span class="text-center">Concluída</span></div>
                    @foreach (var t in os.Tarefas.OrderBy(t => t.Ordem))
                    {
                        <label class="checklist-linha mb-0">
                            <span class="texto">@t.Descricao</span>
                            <span class="marca-ok"><input type="checkbox" class="form-check-input tarefa" name="Concluidas" value="@t.Id" checked="@t.Concluida" /></span>
                        </label>
                    }
                    @if (!os.Tarefas.Any()) { <p class="text-muted">Esta OS não tem tarefas.</p> }
                    <p class="contagem mt-2"><span id="qtdFeitas">@os.Tarefas.Count(t => t.Concluida)</span> de @os.Tarefas.Count tarefas concluídas</p>
                }
            </div>

            <div class="tab-pane fade painel-form" id="aba-pecas">
                <p class="text-muted small">Lance as peças gastas nesta OS. Digite o código: as peças do Spare Parts aparecem para escolher. Ao concluir a OS, o uso fica registrado no Spare Parts.</p>
                @* Sugestões do Spare Parts no campo Código (Pages/SpareParts); escolher preenche a descrição (script no fim). *@
                <datalist id="catalogoPecas">
                    @foreach (var c in Model.Catalogo) { <option value="@c.Codigo" data-desc="@c.Descricao">@c.Descricao</option> }
                </datalist>
                @* Colunas: Código · Peça · Qtd. (no celular: Código e Qtd. em cima, Peça embaixo — estilos.css "Peças da OS") *@
                <div class="peca peca-titulos d-none d-sm-grid"><span>Código</span><span>Peça</span><span>Qtd.</span></div>
                <div id="listaPecas">
                    @{ var ip = 0; }
                    @foreach (var p in os.Pecas)
                    {
                        <div class="peca">
                            <input class="form-control peca-codigo" data-campo="Codigo" name="PecasInput[@ip].Codigo" value="@p.Codigo" placeholder="Código" list="catalogoPecas" autocomplete="off" />
                            <input class="form-control peca-nome" data-campo="Descricao" name="PecasInput[@ip].Descricao" value="@p.Descricao" placeholder="Peça" />
                            <input class="form-control" data-campo="Quantidade" type="number" step="0.01" min="0" name="PecasInput[@ip].Quantidade" value="@p.Quantidade.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            <button type="button" class="btn btn-outline-danger" data-remover-linha=".peca">@Icones.Svg("x", 16)</button>
                        </div>
                        ip++;
                    }
                </div>
                <button type="button" class="btn-ms b-azul mt-2" id="addPeca">@Icones.Svg("mais") Adicionar peça</button>
            </div>

            <div class="tab-pane fade painel-form" id="aba-imagens">
                <p class="text-muted small">Fotos de antes e depois do serviço. No celular abre a câmera. Pode juntar várias fotos antes de salvar. Só vale foto tirada hoje; a data e a hora aparecem em cada foto. As fotos são reduzidas a até 1600px e apagadas após 90 dias.</p>
                <p class="small fw-bold mb-0" style="color:var(--atrasada)">Obrigatório para concluir a OS: pelo menos uma foto de Antes e uma de Depois.</p>
                @foreach (var tipo in new[] { TipoImagem.Antes, TipoImagem.Depois })
                {
                    <h6 class="mt-3 obrig-titulo">@tipo</h6>
                    <div class="galeria mb-2" data-galeria="@tipo">
                        @foreach (var img in os.Imagens.Where(i => i.Tipo == tipo))
                        {
                            <figure>
                                <a class="foto-quadro" href="/Foto/@img.Id" target="_blank"><img src="/Foto/@img.Id" alt="Foto @tipo" loading="lazy" /><span class="foto-hora">@img.Hora().ToString("dd/MM/yyyy HH:mm")</span></a>
                                <figcaption><label><input type="checkbox" name="RemoverImagens" value="@img.Id" /> remover</label></figcaption>
                            </figure>
                        }
                    </div>
                    @* Cada foto tirada/escolhida soma às anteriores e aparece em miniatura até Salvar (interacoes.js seção 11). *@
                    <div class="galeria mb-2" id="novas-@tipo"></div>
                    <label class="btn-ms b-azulclaro mb-1" style="cursor:pointer">
                        @Icones.Svg("camera") Foto — @tipo
                        <input type="file" name="Fotos@(tipo)" accept="image/*" capture="environment" multiple hidden data-fotos="#novas-@tipo" />
                    </label>
                    <div class="small text-success" data-fotos-aviso="#novas-@tipo"></div>
                }
            </div>
        </div>
    </div>
    <div class="lado">
        <button class="btn-ms b-verde" name="acao" value="salvar">Salvar</button>
        @if (!Model.Novo && os.Tarefas.Any())
        {
            <button type="button" class="btn-ms b-contorno" id="selecionarTudo">@Icones.Svg("check", 16) <span data-tudo="marcar">Selecionar tudo</span><span data-tudo="desmarcar" hidden>Desmarcar tudo</span></button>
        }
        @if (!Model.Novo && !os.Tarefas.Any())
        {
            <button class="btn-ms b-verde" name="acao" value="concluir" data-confirmar="Concluir esta OS? A conclusão vai para a Finalização e a OS reinicia com novo prazo.">@Icones.Svg("ok", 16) Concluir OS</button>
        }
        <button class="btn-ms b-azul" name="acao" value="outro">Salvar e adicionar outro(a)</button>
        <button class="btn-ms b-azul" name="acao" value="continuar">Salvar e continuar editando</button>
        @if (!Model.Novo && Model.Pode("ordens_gestao"))
        {
            <button class="btn-ms b-vermelho" asp-page-handler="Remover" data-confirmar="Remover esta OS? As finalizações dela também serão apagadas." formnovalidate>Remover</button>
        }
        @if (!Model.Novo)
        {
            <div class="sep"></div>
            <a class="btn-ms b-cinza" asp-page="/Historico/Index" asp-route-entidade="OrdemServico" asp-route-id="@os.Id">Histórico</a>
            <a class="btn-ms b-cinza" asp-page="Imprimir" asp-route-id="@os.Id" target="_blank">@Icones.Svg("imprimir", 16) Imprimir</a>
        }
        @* NRE (Pages/Nre): salva o andamento (sem concluir) e abre uma NRE com esta máquina e as peças lançadas. *@
        @if (!Model.Novo && Model.Ve("nre"))
        {
            <div class="sep"></div>
            @if (Model.Pode("nre"))
            {
                <button class="btn-ms b-azul" name="acao" value="nre" title="Salva o andamento (sem concluir) e abre uma NRE com esta máquina e as peças lançadas">@Icones.Svg("nre", 16) Salvar e abrir NRE</button>
            }
            @foreach (var n in Model.NresDaOs)
            {
                <a class="lado-nre" asp-page="/Nre/Editar" asp-route-id="@n.Id">@n.Numero · <span class="@n.Status.Css()">@n.Status.Nome()</span></a>
            }
        }
    </div>
</form>

<template id="tplPeca">
    <div class="peca">
        <input class="form-control peca-codigo" data-campo="Codigo" placeholder="Código" list="catalogoPecas" autocomplete="off" />
        <input class="form-control peca-nome" data-campo="Descricao" placeholder="Peça" />
        <input class="form-control" type="number" step="0.01" min="0" value="1" data-campo="Quantidade" />
        <button type="button" class="btn btn-outline-danger" data-remover-linha=".peca">@Icones.Svg("x", 16)</button>
    </div>
</template>

@section Scripts {
    <script>
        // Selecionar tudo: marca todas as tarefas (com tudo marcado, o botão vira "Desmarcar tudo"); depois clique em Salvar.
        const caixasTarefa = () => [...document.querySelectorAll('input.tarefa')];
        document.getElementById('selecionarTudo')?.addEventListener('click', () => {
            const marcar = !caixasTarefa().every(c => c.checked);
            caixasTarefa().forEach(c => c.checked = marcar);
            bootstrap.Tab.getOrCreateInstance(document.getElementById('linkTarefas')).show();
            contar();
        });
        function contar() {
            const el = document.getElementById('qtdFeitas');
            if (el) el.textContent = caixasTarefa().filter(c => c.checked).length;
            const todas = caixasTarefa().length > 0 && caixasTarefa().every(c => c.checked);
            document.querySelector('[data-tudo=marcar]')?.toggleAttribute('hidden', todas);
            document.querySelector('[data-tudo=desmarcar]')?.toggleAttribute('hidden', !todas);
        }
        contar();
        document.querySelectorAll('input.tarefa').forEach(c => c.addEventListener('change', contar));

        // Spare Parts: escolher um código do cadastro preenche a descrição da peça (se estiver vazia ou foi preenchida assim).
        document.getElementById('listaPecas').addEventListener('change', e => {
            if (!e.target.matches('.peca-codigo')) return;
            const codigo = e.target.value.trim().toUpperCase();
            const op = [...document.querySelectorAll('#catalogoPecas option')].find(o => o.value === codigo);
            const desc = e.target.closest('.peca').querySelector('.peca-nome');
            if (!op || !desc) return;
            e.target.value = codigo;
            if (desc.value === '' || desc.dataset.auto === '1') { desc.value = op.dataset.desc; desc.dataset.auto = '1'; }
        });
        document.getElementById('listaPecas').addEventListener('input', e => { if (e.target.matches('.peca-nome')) delete e.target.dataset.auto; });

        // Peças: renumera os índices antes de enviar.
        document.getElementById('addPeca').addEventListener('click', () => {
            const lista = document.getElementById('listaPecas');
            lista.appendChild(document.getElementById('tplPeca').content.cloneNode(true));
            lista.lastElementChild.querySelector('input').focus();
        });
        // Salvar com pelo menos uma tarefa marcada conclui o ciclo (vai para a Finalização): confirma antes.
        // "Salvar e continuar editando" só guarda o andamento.
        // A pergunta aparece na janela do sistema (msConfirmar, em wwwroot/js/interacoes.js).
        const tarefas = [...document.querySelectorAll('input.tarefa')];
        const formOs = document.getElementById('formOs');
        let envioConfirmado = false;
        // Fotos obrigatórias para concluir: pelo menos uma de Antes e uma de Depois (o servidor confere de novo).
        const qtdFotos = tipo => [...document.querySelectorAll(`[data-galeria="${tipo}"] figure`)]
                .filter(f => !f.querySelector('input[name=RemoverImagens]:checked')).length
            + [...document.querySelectorAll(`#novas-${tipo} input[type=file]`)].reduce((s, i) => s + i.files.length, 0);
        function faltamFotos() {
            if (qtdFotos('Antes') > 0 && qtdFotos('Depois') > 0) return false;
            const t = s => window.msT ? msT(s) : s;
            msAvisar(t('Para concluir a OS, tire pelo menos uma foto de Antes e uma de Depois.'));
            bootstrap.Tab.getOrCreateInstance(document.querySelector('[data-bs-target="#aba-imagens"]')).show();
            return true;
        }
        formOs.addEventListener('submit', e => {
            if (envioConfirmado) { envioConfirmado = false; return; }
            if ((e.submitter?.getAttribute('formaction') || '').includes('handler=')) return;
            if (e.submitter?.value === 'continuar' || e.submitter?.value === 'nre') return;
            const vaiConcluir = @(Model.Novo ? "false" : "true") && (e.submitter?.value === 'concluir' || tarefas.some(c => c.checked));
            if (vaiConcluir && faltamFotos()) { e.preventDefault(); return; }
            const feitas = tarefas.filter(c => c.checked).length;
            if (!feitas || !tarefas.length) return;
            e.preventDefault();
            const t = s => window.msT ? msT(s) : s;
            const msg = t('Enviar para a Finalização? {feitas} de {total} tarefas marcadas; as não marcadas ficam registradas como não feitas. A OS continua na lista com a próxima data da manutenção.')
                .replace('{feitas}', feitas).replace('{total}', tarefas.length);
            const botao = e.submitter;
            msConfirmar(msg, { titulo: t('Enviar para a Finalização'), botao: t('Enviar'), classe: 'b-verde' }).then(sim => {
                if (!sim) return;
                envioConfirmado = true;
                formOs.requestSubmit(botao || undefined);
            });
        });
        document.getElementById('formOs').addEventListener('submit', () => {
            document.querySelectorAll('#listaPecas .peca').forEach((linha, i) => {
                linha.querySelectorAll('[data-campo]').forEach(c => c.name = `PecasInput[${i}].${c.dataset.campo}`);
            });
        });
    </script>
}
