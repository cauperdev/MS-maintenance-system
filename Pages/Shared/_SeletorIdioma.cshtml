@*
    ============================================================================
    CAIXA DE IDIOMA (topo da tela) — Português, English, Español, Chinês, Coreano. As traduções estão em wwwroot/js/traducao.js.
    ============================================================================
*@
<div class="idioma" data-sem-traducao>
    @Icones.Svg("globo", 18)
    <select id="seletorIdioma" class="form-select form-select-sm" aria-label="Idioma / Language">
        <option value="pt">Português</option>
        <option value="en">English</option>
        <option value="es">Español</option>
        <option value="zh">Chinês</option>
        <option value="ko">Coreano</option>
    </select>
</div>
